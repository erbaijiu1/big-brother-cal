# 旧版报价页 Nginx 示例，仅保留作历史参考。
# 新的企业官网生产部署请使用同目录下 yjhcai.cn.conf.example，首页位于域名根路径 /。
# 1. 确认域名证书路径和 upstream 地址。
# 2. 将静态包内容解压到 /var/www/hk-logistics-quote/。
# 3. 如果 Nginx 与后端同在 Docker 网络，将 127.0.0.1:8088 改为 cal_price_server:8088。

upstream cal_price_backend {
    server 127.0.0.1:8088;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name yjhcai.cn www.yjhcai.cn;

    # 正式启用 HTTPS 后，建议打开跳转并删除下方静态站配置。
    # return 301 https://$host$request_uri;

    root /var/www/hk-logistics-quote;
    index index.html;

    charset utf-8;
    client_max_body_size 2m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # uni-app H5 使用前端路由；找不到静态文件时回退到首页。
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 报价页公开接口：分类、地区和试算。
    location = /cal_price/classify/classify_list {
        limit_except POST { deny all; }
        proxy_pass http://cal_price_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /cal_price/public/districts {
        limit_except GET { deny all; }
        proxy_pass http://cal_price_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /cal_price/pricing_rule/min_pricing {
        limit_except POST { deny all; }
        proxy_pass http://cal_price_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # 官网不开放计费管理、登录等其他后台接口。
    location /cal_price/ {
        return 404;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}

# HTTPS 示例（证书就绪后启用）：
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name yjhcai.cn www.yjhcai.cn;
#     ssl_certificate     /etc/letsencrypt/live/yjhcai.cn/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/yjhcai.cn/privkey.pem;
#     # 将上面 server 中 root、location 和安全头配置移到这里。
# }
